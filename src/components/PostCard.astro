---
import type { CollectionEntry } from 'astro:content';
import { BASE_URL } from '../consts';
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const date = post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<article class="card reveal flex min-h-64 flex-col p-6">
  <div class="mb-5 flex flex-wrap gap-2">{post.data.tags.map((tag) => <span class="rounded-full bg-[color-mix(in_srgb,var(--accent)_10%,transparent)] px-2.5 py-1 text-xs text-[var(--accent)]">{tag}</span>)}</div>
  <h3 class="text-xl font-semibold leading-snug tracking-tight"><a class="after:absolute after:inset-0" href={`${BASE_URL}/blog/${post.id}/`}>{post.data.title}</a></h3>
  <p class="mt-3 line-clamp-3 text-sm text-[var(--muted)]">{post.data.description}</p>
  <time class="mt-auto pt-8 text-xs text-[var(--muted)]" datetime={post.data.pubDate.toISOString()}>{date}</time>
</article>
