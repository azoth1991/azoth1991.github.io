---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BASE_URL } from '../../consts';
---
<BaseLayout title="Playground — Azoth" description="Canvas, CSS, and interactive browser experiments.">
  <section class="container py-20">
    <p class="eyebrow">Playground</p><h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Frontend Experiments</h1><p class="mt-4 max-w-xl text-[var(--muted)]">Compiling curiosity into tangible pixels. Every experiment runs locally in your browser.</p>
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      <a class="card group p-2" href={`${BASE_URL}/playground/particle-field/`}><div class="grid aspect-[16/9] place-items-center rounded-2xl bg-[radial-gradient(circle_at_center,color-mix(in_srgb,var(--accent)_35%,transparent),transparent_65%)]"><span class="text-5xl transition group-hover:scale-110">✦</span></div><div class="p-5"><p class="eyebrow">Canvas</p><h2 class="mt-1 text-xl font-semibold">Gravity Particle Field</h2><p class="mt-2 text-sm text-[var(--muted)]">Move your pointer and watch particles flow between gravity and inertia.</p></div></a>
      <a class="card group p-2" href={`${BASE_URL}/playground/filesystem/`}><div class="grid aspect-[16/9] place-items-center overflow-hidden rounded-2xl bg-[#0d1117] font-mono text-sm text-slate-400"><div class="w-4/5 rounded-xl border border-white/10 bg-white/5 p-4 shadow-2xl"><p><span class="text-violet-400">class</span> <span class="text-cyan-300">FileSystem</span> {'{'}</p><p class="pl-4"><span class="text-violet-400">run</span>(tests); <span class="text-emerald-400">✓</span></p><p>{'}'}</p></div></div><div class="p-5"><p class="eyebrow">Code runner</p><h2 class="mt-1 text-xl font-semibold">File System Challenge</h2><p class="mt-2 text-sm text-[var(--muted)]">Implement an in-memory file system and run a full test suite in your browser.</p></div></a>
    </div>
  </section>
</BaseLayout>
