---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found — Azoth"><section class="container grid min-h-[65vh] place-items-center py-20 text-center"><div><p class="gradient-text text-8xl font-bold">404</p><h1 class="mt-3 text-2xl font-semibold">These pixels don't exist yet</h1><p class="mt-3 text-[var(--muted)]">The page may have moved, or it might still be under construction.</p><a class="mt-8 inline-block rounded-full bg-[var(--text)] px-6 py-3 text-sm font-semibold text-[var(--bg)]" href={import.meta.env.BASE_URL}>Back home</a></div></section></BaseLayout>
