---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, BASE_URL } from '../consts';

interface Props { title?: string; description?: string; image?: string; type?: 'website' | 'article'; }
const { title = SITE_TITLE, description = SITE_DESCRIPTION, image, type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image ? new URL(image, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090b10" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${BASE_URL}/favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} RSS`} href={`${BASE_URL}/rss.xml`} />
    <meta property="og:type" content={type} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      (() => { const saved = localStorage.getItem('theme'); const dark = matchMedia('(prefers-color-scheme: dark)').matches; document.documentElement.dataset.theme = saved || (dark ? 'dark' : 'light'); })();
    </script>
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <script>
      const reveal = new IntersectionObserver((entries) => entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add('visible')), { threshold: .12 });
      document.querySelectorAll('.reveal').forEach((element) => reveal.observe(element));
    </script>
  </body>
</html>
